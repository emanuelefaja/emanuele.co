{# Expects `items`: a list of posts. Optional `dateFormat`: "short" (2 Sep) or "medium" (2 Sep 2025). #}
<ul class="posts">
{%- for post in items %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a> <time datetime="{{ post.date | date('iso') }}">{{ post.date | date(dateFormat or 'short') }}</time></li>
{%- endfor %}
</ul>
