<script>
(function () {
  var nav = document.querySelector('.work-nav');
  var links = document.querySelectorAll('.work-nav a');
  if (!links.length || !('IntersectionObserver' in window)) return;
  var byId = {};
  links.forEach(function (a) { byId[a.getAttribute('href').slice(1)] = a; });
  function activate(a) {
    links.forEach(function (l) { l.removeAttribute('aria-current'); });
    a.setAttribute('aria-current', 'true');
    nav.style.setProperty('--y', a.offsetTop + 'px');
    nav.style.setProperty('--h', a.offsetHeight + 'px');
  }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) activate(byId[e.target.id]); });
  }, { rootMargin: '-20% 0px -70% 0px' });
  window.addEventListener('resize', function () {
    var a = document.querySelector('.work-nav a[aria-current]');
    if (a) activate(a);
  });
  Object.keys(byId).forEach(function (id) { var el = document.getElementById(id); if (el) io.observe(el); });
  activate(links[0]);
})();
</script>
